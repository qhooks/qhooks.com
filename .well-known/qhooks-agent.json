    {
      "name": "agreement_from_template",
      "description": "Prepare an agreement from milestones, arbiter_escrow, time_release, optimistic or panel. No price-trigger template. Never signs or sends.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {

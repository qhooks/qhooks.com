        ],
        "additionalProperties": false
      }
    },
    {
      "name": "perps_markets",
      "description": "Read Hyperliquid native perpetual markets, mark prices and funding. Bounded public info read; short cache, no orders or signing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "coin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,32}$"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "perps_positions",
      "description": "Read public Hyperliquid positions and unrealized PnL for an address. Short cache; realized/lifetime PnL remains unknown.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        },
        "required": [
          "address"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "prepare_perps_order",
      "description": "Prepare one unsigned Hyperliquid native perpetual limit/IOC order or first-time 0.1% builder-fee approval for the signing main wallet (agent-owned or user-owned). Does not sign, submit, change leverage or create an API wallet. Requires configured QHooks builder and an allowed edge region.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "coin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,32}$"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "size": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,18})?$",
            "description": "Exact base-coin size; never USDC notional."
          },
          "limitPrice": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,18})?$",
            "description": "Explicit price bound in USD. IOC can partly fill or cancel; never an unbounded market order."
          },
          "timeInForce": {
            "type": "string",
            "enum": [
              "Ioc",
              "Gtc",
              "Alo"
            ]
          },
          "reduceOnly": {
            "type": "boolean"
          },
          "nonce": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Fresh millisecond nonce allocated by the user wallet; coordinate with its other Hyperliquid actions."
          }
        },
        "required": [
          "address",
          "coin",
          "side",
          "size",
          "limitPrice",
          "timeInForce",
          "nonce"
        ],
        "additionalProperties": false
      }
    },

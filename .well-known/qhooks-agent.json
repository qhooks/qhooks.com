{
  "name": "com.qhooks/mcp",
  "version": "8.1.0",
  "endpoint": "https://qhooks.com/mcp",
  "skill": "https://qhooks.com/skill.md",
  "tools": [
    {
      "name": "otc_quote",
      "description": "Read and validate agreed OTC parties/amounts on Robinhood Chain; calculate fee tier and a short-lived planning quote. The signing wallet (agent-owned or user-owned) reviews the agreed terms before signing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "4663"
            ]
          },
          "buyer": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "seller": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "type": "string"
          },
          "payAsset": {
            "type": "string",
            "description": "ETH, WETH, USDG or that fixed payment-token address"
          },
          "payAmount": {
            "type": "string"
          },
          "expiry": {
            "type": "integer"
          }
        },
        "required": [
          "buyer",
          "seller",
          "token",
          "amount",
          "payAsset",
          "payAmount",
          "expiry"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "otc_create",
      "description": "Prepare simulated unsigned createDeal transactions from an otc_quote result. Only buyer signs. fundNow defaults false; actual receipt determines dealId. Confirm approvals then re-prepare when required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "4663"
            ]
          },
          "actor": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "quote": {
            "type": "object"
          },
          "fundNow": {
            "type": "boolean"
          },
          "dryRun": {
            "type": "boolean"
          }
        },
        "required": [
          "actor",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "otc_accept",
      "description": "Read an actual deal and prepare the named buyer/seller deposit. Requires the termsHash from a recent deal_status. Exact token approvals; no key/sign/send. Never infers a dealId.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "4663"
            ]
          },
          "dealId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "actor": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "expectedTermsHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "payout": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "dryRun": {
            "type": "boolean"
          }
        },
        "required": [
          "dealId",
          "actor",
          "expectedTermsHash"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "deal_status",
      "description": "Read an actual QOtcEscrow deal, immutable terms hash, funding state, claimable balances and simulated user refund/cancel/withdraw actions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "4663"
            ]
          },
          "dealId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "actor": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        },
        "required": [
          "dealId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "agreement_create",
      "description": "Prepare simulated unsigned create/fund transactions for explicit conditions; the payer wallet signs. Exact decimal amounts, chain-time validation, fee 0.5% on released tranches. Approval may be staged.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "4663"
            ]
          },
          "payer": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "payee": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "asset": {
            "type": "string"
          },
          "expiry": {
            "type": "integer"
          },
          "expiresInDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "terms": {
            "type": "string",
            "maxLength": 4096
          },
          "dryRun": {
            "type": "boolean"
          },
          "tranches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string"
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "integer",
                        "enum": [
                          1,
                          2,
                          3,
                          6
                        ]
                      },
                      "k": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "parties": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^0x[0-9a-fA-F]{40}$"
                        },
                        "maxItems": 9,
                        "minItems": 0
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 8,
                  "minItems": 1
                }
              },
              "required": [
                "amount",
                "conditions"
              ],
              "additionalProperties": false
            },
            "maxItems": 10,
            "minItems": 1
          }
        },
        "required": [
          "payer",
          "payee",
          "asset",
          "tranches"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "agreement_fund",
      "description": "Prepare atomic creation and funding from the full agreement specification. Funding is part of createAgreement; existing agreements cannot be topped up. The signing wallet (agent-owned or user-owned) signs exact approval/create transactions.",
